<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hasselblad_check_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/hasselblad_check_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/hasselblad_check_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/hasselblad_check_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:text="@string/hasselblad_check_pending" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="@string/hasselblad_check_scope" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hasselblad_check_explanation" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_check_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hasselblad_check_run" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_check_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hasselblad_check_copy" />
            <!-- On-demand only: the 729-point grid must not run in the shutter path. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_domain_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Run Domain1 temperature/tint coverage" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_domain_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Copy Domain1 JSON" />
            <TextView
                android:id="@+id/hasselblad_domain_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:text="Run this diagnostic after a RAW photo. Photon colour is unchanged." />

            <TextView
                android:id="@+id/hasselblad_check_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textIsSelectable="true" />
            <TextView
                android:id="@+id/hasselblad_check_provenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textIsSelectable="true" />
            <TextView
                android:id="@+id/hasselblad_check_capture_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textIsSelectable="true"
                android:text="@string/hasselblad_check_capture_json" />
            <TextView
                android:id="@+id/hasselblad_check_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
