<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hasselblad_check_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/hasselblad_check_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/hasselblad_check_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/hasselblad_check_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:text="@string/hasselblad_check_pending" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="@string/hasselblad_check_scope" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hasselblad_check_explanation" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_check_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hasselblad_check_run" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_check_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hasselblad_check_copy" />
            <!-- On-demand only: the 729-point grid must not run in the shutter path. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_domain_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Run Domain1 temperature/tint coverage" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_domain_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Copy Domain1 JSON" />
            <TextView
                android:id="@+id/hasselblad_domain_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:text="Run this diagnostic after a RAW photo. Photon colour is unchanged." />

            <!-- Stage6 is armed manually and samples only one later Bayer draw. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage6_arm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Arm Stage6 GPU comparison for next RAW photo" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage6_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Copy Stage6 GPU report JSON" />
            <TextView
                android:id="@+id/hasselblad_stage6_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:text="Stage6 is not armed. GPU data never changes saved photo colours." />

            <!-- Stage8: explicit opt-in, synthetic LUT preparation self-test only. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage8_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Run Stage8 LUT preparation self-test" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage8_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Copy Stage8 test report JSON" />
            <TextView
                android:id="@+id/hasselblad_stage8_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:text="Stage8 not run. Synthetic profile generation only; Photon colour remains active." />

            <!-- Stage26: on-demand only; exercises native PCS maths on synthetic tiles.
                 No photographic rendering or X2D MAIN pixel stages run. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage26_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Run Stage26 neutral colour JNI self-test" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage26_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Copy Stage26 diagnostic JSON" />
            <TextView
                android:id="@+id/hasselblad_stage26_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:text="Stage26 not run. Linear DNG PCS reference only; Photon JPEG colour is unchanged." />

            <!-- Stage32: explicitly selected existing DNG only. No capture,
                 photo save, camera HAL or vendor colour operation is changed. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage32_pick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Stage32: Pick existing DNG for neutral tile test" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage32_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Copy Stage32 DNG diagnostic JSON" />
            <TextView
                android:id="@+id/hasselblad_stage32_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:text="Stage32 not run. Choose a local DNG; no image modification or Hasselblad pixel render." />

            <!-- Stage34: explicitly select the matching sidecar AFTER a successful
                 Stage32 DNG pick. Hash and Camera2 metadata matched privately. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage34_pick_sidecar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:text="Stage34: Pick matching capture JSON to verify DNG white balance" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hasselblad_stage34_copy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Copy Stage34 WB provenance report" />
            <TextView
                android:id="@+id/hasselblad_stage34_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:text="Stage34 not run. Pick the original DNG with Stage32 first." />

            <TextView
                android:id="@+id/hasselblad_check_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textIsSelectable="true" />
            <TextView
                android:id="@+id/hasselblad_check_provenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textIsSelectable="true" />
            <TextView
                android:id="@+id/hasselblad_check_capture_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textIsSelectable="true"
                android:text="@string/hasselblad_check_capture_json" />
            <TextView
                android:id="@+id/hasselblad_check_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
