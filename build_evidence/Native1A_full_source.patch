+enum LJ92_ERRORS {
+  LJ92_ERROR_NONE = 0,
+  LJ92_ERROR_CORRUPT = -1,
+  LJ92_ERROR_NO_MEMORY = -2,
+  LJ92_ERROR_BAD_HANDLE = -3,
+  LJ92_ERROR_TOO_WIDE = -4
+};
